<h1>Merhaba</h1>using Microsoft.AspNetCore.Mvc.Rendering;
@model VizeTekrar.Models.Ogrenciler
@{
    ViewData["Title"] = "Öğrenci Güncelle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mt-3 mb-3">Öğrenci Bilgilerini Güncelle</h2>
@using (Html.BeginForm("Guncelle", "Ogrenci", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <input type="hidden" asp-for="Id" />
    @Html.AntiForgeryToken()
    <!--primary key olduğu için gizli olmalıdır-->
    <input type="hidden" name="OgrencilerId" value="@Model.OgrenciNo" />
    <table class="table table-bordered align-middle">
        <tbody>
            <tr>
                
                <td rowspan="9" class="text-center align-middle bg-light" style="width: 220px;">
                    <label class="fw-bold d-block mb-2">Mevcut Fotoğraf</label>
                    <img src="@(string.IsNullOrEmpty(Model.FotografYolu) ? "/resimler/default.png" : Model.FotografYolu)"
                         class="img-thumbnail rounded shadow-sm mb-2"
                         style="width: 180px; height: 200px; object-fit: cover;"
                         alt="@Model.Ad @Model.Soyad" />
                </td>
                
                <th style="width: 25%;" class="bg-light">T.C. Kimlik No</th>

            </tr>
            <tr>
                <th class="bg-light">Adı</th>
                <td>
                    <input type="text" name="Ad" value="@Model.Ad" class="form-control" required />
                </td>
            </tr>
            <tr>
                <th class="bg-light">Soyadı</th>
                <td>
                    <input type="text" name="Soyad" value="@Model.Soyad" class="form-control" required />
                </td>
            </tr>
            <tr>
                <th class="bg-light">Cinsiyet</th>
                <td>
                    <select name="Cinsiyet" class="form-select" required>
                        <option value="Erkek" selected="@(Model.Cinsiyet == "Erkek")">Erkek</option>
                        <option value="Kadın" selected="@(Model.Cinsiyet == "Kadın")">Kadın</option>
                    </select>
                </td>
            </tr>
            <tr>
                <th class="bg-light">Doğum Tarihi</th>
                <td>
                    <input type="date" name="DogumTarihi" value="@Model.DogumTarihi.ToString("yyyy-MM-dd")"
                           class="form-control" required />
                </td>
            </tr>
            <tr>
                <th class="bg-light">E-Posta Adresi</th>
                <td>
                    <input type="email" name="Eposta" value="@Model.Eposta" class="form-control" required />
                </td>
            </tr>
            <tr>
                <th class="bg-light">Telefon Numarası</th>
                <td>
                    <input type="tel" name="Telefon" value="@Model.Telefon" class="form-control" required />
                </td>
            </tr>
           
            <tr>
                <th class="bg-light">Bölüm</th>
                <td>
                    @Html.DropDownList("BolumlerId",
                    ViewBag.BolumListesi as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()),
                                "--- Bölüm Seçiniz ---",
                                new { @class = "form-select", @required = "required" })
            </td>
        </tr>
        <tr>
            <th class="bg-light">Fotoğrafı Değiştir</th>
            <td>
                <input type="file" name="ResimURL" class="form-control" accept=".jpg,.jpeg,.png,.bmp" />
                <small class="text-muted">Boş bırakırsanız mevcut fotoğraf korunur.</small>
            </td>
        </tr>
    </tbody>
</table>
<div class="mt-3">
    <button type="submit" class="btn btn-success">Güncelle ve Kaydet</button>
    <a href="/Ogrenciler/Index" class="btn btn-secondary float-end">İptal / Listeye Dön</a>
</div>
}
