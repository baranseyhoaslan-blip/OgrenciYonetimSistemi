
@model VizeTekrar.Models.Ogrenciler
@{
    ViewData["Title"] = "Öğrenci Detayı";
}
<div class="container mt-4">
   
    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-info mb-3">
            @TempData["Mesaj"]
        </div>
    }
    <h2>Öğrenci Detay Bilgileri</h2>
    <h1>@Model.Bolum.BolumAdi</h1>
    <hr />
    <div class="row">
        
        <div class="col-md-3 text-center mb-4">
            @if (!string.IsNullOrEmpty(Model.FotografYolu))
            {
                <img src="@Model.FotografYolu" alt="Öğrenci Fotoğrafı" class="img-fluid rounded
    shadow-sm" style="max-width: 180px; height: 180px; object-fit: cover;" />
            }
            else
            {
                <img src="/Uploads/Ogrenciler/default-avatar.jpg" alt="Varsayılan Fotoğraf"
                     class="img-fluid rounded shadow-sm" style="max-width: 180px; height: 180px; object-fit: cover;" />
            }
        </div>
       
        <div class="col-md-9">
            <table class="table table-striped table-bordered">
                <tbody>
                    <tr>
                        <th style="width: 30%;">Öğrenci ID</th>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <th>Adı</th>
                        <td>@Model.Ad</td>
                    </tr>
                    <tr>
                        <th>Soyadı</th>
                        <td>@Model.Soyad</td>
                    </tr>
                    <tr>
                        <th>Cinsiyet</th>
                        <td>@Model.Cinsiyet</td>
                    </tr>
                    <tr>
                        <th>Doğum Tarihi</th>
                        <td>@Model.DogumTarihi.ToString("dd.MM.yyyy")</td>
                    </tr>
                    <tr>
                        <th>E-posta</th>
                        <td>@Model.Eposta</td>
                    </tr>
                    <tr>
                        <th>Telefon</th>
                        <td>@Model.Telefon</td>
                    </tr>
                    <tr>
                        <th>Başvuru Programı</th>
                        <td>@Model.Bolum.BolumAdi</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="mt-3">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Listeye Dön
        </a>
    </div>
</div>