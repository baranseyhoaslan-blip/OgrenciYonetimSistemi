@model List<VizeTekrar.Models.Ogrenciler>
@{
    ViewBag.Title = "Öğrenci Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2 class="mt-3">Öğrenci Listesi</h2>
<br />
<a asp-controller="Ogrenci" asp-action="OgrenciEkle" class="btn btn-primary">Öğrenci Ekle</a>
<br />
<br />
<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            
            <th>Öğrenci TC No</th>
            <th>Öğrenci Adı</th>
            <th>Öğrenci Soyadı</th>
            <th>Bölüm</th>
            <th class="text-center" style="width: 220px;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OgrenciNo</td>
                    <td>@item.Ad</td>
                    <td>@item.Soyad</td>
                   
                    <td>@(item.Bolum?.BolumAdi ?? "Bölüm Atanmamış")</td>
                    <td>
                        <div class="d-flex gap-1 justify-content-center">
                            @using (Html.BeginForm("Sil", "Ogrenci", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istiyor musunuz?');">Sil</button>
                            }

                            
                            <a href="/Ogrenci/Guncelle/@item.Id" class="btn btn-sm btn-success">Güncelle</a>
                            <a href="/Ogrenci/Detay/@item.Id" class="btn btn-sm btn-warning">Detay</a>
                            <a href="/Ogrenci/OgrenciBul/@item.Id" class="btn btn-sm btn-primary">IDGetir</a>

                        </div>  
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Kayıtlı öğrenci bulunamadı.</td>
            </tr>
        }
    </tbody>
</table>
